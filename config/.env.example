# Copy this file to config/.env and fill in the values. config/.env is never committed.
# One NAME=value per line, no spaces around the = sign.

# ElevenLabs API key (elevenlabs.io > Developers > API keys). Needs access to the Music API.
# This is the only thing that costs money per run: about 200 to 300 credits a song.
ELEVENLABS_API_KEY=

# --- Posting to Instagram (optional; leave empty if you post by hand) ---

# Long-lived Instagram access token from your Meta developer app
# (Instagram > API setup with Instagram login > Generate token). Starts with IG. Lasts about 60 days.
INSTAGRAM_ACCESS_TOKEN=

# Read-write token of your Vercel Blob store (Vercel dashboard > Storage > your store > .env.local).
# Starts with vercel_blob_rw_. The reel sits there for a minute so Instagram can fetch it.
BLOB_READ_WRITE_TOKEN=

# Only for a Facebook Login token (starts with EAA) instead of an Instagram Login one.
# With these two set, the reel is uploaded to Meta directly and BLOB_READ_WRITE_TOKEN is not needed.
# INSTAGRAM_GRAPH_HOST=graph.facebook.com
# INSTAGRAM_USER_ID=
